# Copy to .env and adjust for your machine:
#   cp .env.example .env
#
# start.sh sources .env automatically.

# LibreOffice binary for visual MAD + true page-count validation
# macOS:  /Applications/LibreOffice.app/Contents/MacOS/soffice
# Linux:  /usr/bin/soffice   or   /usr/bin/libreoffice
# Windows: C:\Program Files\LibreOffice\program\soffice.exe
# Leave unset to auto-detect via PATH / scripts/find_soffice.sh
# PDF2WORD_SOFFICE=/Applications/LibreOffice.app/Contents/MacOS/soffice

# Set to 1 only if optional third_party parsers + models are installed
# PDF2WORD_ENABLE_EXTERNAL_PARSERS=0

# Optional: override workspace root for jobs
# PDF2WORD_WORKSPACE=workspace
